Options -Indexes
<FilesMatch "^(?:config(?:\.example)?\.php|composer\.(?:json|lock)|phpunit\.xml|docker-compose\.yml|router\.php|README\.md|todo\.md)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^(?:app|database|docs|tests|vendor|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^admin/(?:core|views|custom)(?:/|$) - [F,L,NC]
RewriteRule ^admin/resources\.php$ - [F,L,NC]
RewriteRule \.(?:dbml|sql|log|md|lock)$ - [F,L,NC]
